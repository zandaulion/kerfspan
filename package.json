    "test": "node --test \"test/**/*.test.js\"",
    "test:browser": "node --test test/browser/editor-interactions.test.js",
    "test:browser:install": "playwright install chromium"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "express": "^4.21.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
